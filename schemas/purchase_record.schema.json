{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://costing-analyzer.local/schemas/0.2/purchase_record.schema.json",
  "title": "Purchase record",
  "description": "One delivered PO line from the ERP export. The brief names the provenance block source{file, sha256, sheet, row}; it is held in `origin` so that the common `source` block keeps the same shape on all six records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "applies_on",
    "source",
    "purchase_id",
    "po_number",
    "material_code",
    "material_name",
    "material_key",
    "purchase_date",
    "quantity",
    "quantity_unit",
    "currency",
    "unit_price",
    "total_price",
    "supplier",
    "import_or_local",
    "category",
    "flags",
    "raw",
    "origin"
  ],
  "properties": {
    "record_type": {
      "const": "purchase_record"
    },
    "schema_version": {
      "const": "0.2"
    },
    "applies_on": {
      "type": "string",
      "format": "date",
      "description": "The date this record applies to; drives every point-in-time check."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "retrieved_at"
      ],
      "properties": {
        "link": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "purchase_id": {
      "type": "string",
      "pattern": "^\\d+:[^:]+:\\d+$",
      "description": "RECEIPT_NUM:ITEM_CODE:n, n = 1-based order of the line within that receipt and item in file order."
    },
    "po_number": {
      "type": "string"
    },
    "po_header_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lc_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_code": {
      "type": "string"
    },
    "legacy_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_name": {
      "type": "string"
    },
    "material_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$",
          "description": "Material key as read from ITEM_DESCRIPTION. Nylon cord v0.1: 840D/2, 1260D/2, 840D/1, 1890D/2, 1260D/1, chafer. Database doc ids use a slug with / replaced by - (840D-2)."
        },
        {
          "type": "null"
        }
      ],
      "description": "null for excluded categories (CLOTH, TEXTILE)."
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "TRANSACTION_DATE (delivery date). Equals applies_on."
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quantity_unit": {
      "enum": [
        "KGS",
        "MTR"
      ]
    },
    "currency": {
      "const": "PKR"
    },
    "unit_price": {
      "type": "number",
      "minimum": 0
    },
    "total_price": {
      "type": "number",
      "minimum": 0
    },
    "supplier": {
      "type": "string"
    },
    "vendor_site": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin_region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Mill country; null until the vendor-to-origin table is confirmed for traders."
    },
    "origin_basis": {
      "enum": [
        "vendor_name",
        "confirmed_table",
        "verified_source",
        "not_applicable",
        "unknown"
      ]
    },
    "epi": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Ends per inch read from ITEM_DESCRIPTION; material sub-key (PK-25)."
    },
    "import_or_local": {
      "enum": [
        "IMPORT",
        "LOCAL"
      ]
    },
    "delivery_terms": {
      "type": [
        "string",
        "null"
      ]
    },
    "payment_terms": {
      "type": [
        "string",
        "null"
      ]
    },
    "freight_per_receipt": {
      "type": [
        "number",
        "null"
      ],
      "description": "PKR per receipt, repeated on each line of the receipt. Never sum across lines."
    },
    "bilty_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "vehicle_num": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "NYLON CORD",
        "CLOTH",
        "TEXTILE"
      ]
    },
    "store": {
      "type": [
        "string",
        "null"
      ]
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "excluded_from_pricing",
          "excluded_from_volume",
          "intercompany",
          "provisional_duplicate",
          "identical_line",
          "code_description_conflict",
          "duplicate_entry",
          "provisional_price",
          "efs_import",
          "freight_in_price",
          "usance_fx",
          "missing_lc_number"
        ]
      }
    },
    "flag_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw": {
      "type": "object",
      "description": "Every original column (36) of the line, unmodified."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "sheet",
        "row"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sheet": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 3,
          "description": "1-based Excel row (header is row 2)."
        }
      }
    }
  }
}
